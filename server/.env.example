# Server Port
PORT=5000

# MongoDB Connection String (leave empty to automatically use in-memory database)
MONGO_URI=mongodb://127.0.0.1:27017/segrego

# JWT Secret for user authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Client URL (for CORS in production if hosted on separate domain)
CLIENT_URL=http://localhost:3000

# Optional: Cloud integrations
AI_API_KEY=
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
MAP_API_KEY=
